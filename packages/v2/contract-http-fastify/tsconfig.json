{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-contract-http-fastify",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/core": ["../../core/src"],
      "@teable/v2-contract-http-openapi": ["../contract-http-openapi/src"],
      "@teable/v2-contract-http-openapi/*": ["../contract-http-openapi/src/*"],
      "@teable/v2-contract-http/*": ["../contract-http/src/*"],
      "@teable/v2-contract-http-implementation": ["../contract-http-implementation/src"],
      "@teable/v2-contract-http-implementation/*": ["../contract-http-implementation/src/*"],
      "@teable/v2-contract-http": ["../contract-http/src"],
      "@teable/v2-container-node": ["../container-node/src"],
      "@teable/v2-adapter-table-repository-postgres": ["../adapter-table-repository-postgres/src"],
      "@teable/v2-adapter-repository-postgres": ["../adapter-repository-postgres/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-core/*": ["../core/src/*"],
      "@teable/v2-adapter-db-postgres-pg": ["../adapter-db-postgres-pg/src"],
      "@teable/v2-di": ["../di/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../contract-http/src/**/*.spec.ts",
    "../contract-http/src/**/*.test.ts",
    "../contract-http-implementation/src/**/*.spec.ts",
    "../contract-http-implementation/src/**/*.test.ts",
    "../container-node/src/**/*.spec.ts",
    "../container-node/src/**/*.test.ts",
    "../adapter-table-repository-postgres/src/**/*.spec.ts",
    "../adapter-table-repository-postgres/src/**/*.test.ts",
    "../adapter-repository-postgres/src/**/*.spec.ts",
    "../adapter-repository-postgres/src/**/*.test.ts",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../formula/src/**/*.spec.ts",
    "../../formula/src/**/*.test.ts"
  ],
  "include": ["src", "../../core/src"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-benchmark-node",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/core": ["../../core/src"],
      "@teable/v2-container-node-test": ["../container-node-test/src"],
      "@teable/v2-contract-http-client": ["../contract-http-client/src"],
      "@teable/v2-contract-http-express": ["../contract-http-express/src"],
      "@teable/v2-contract-http-fastify": ["../contract-http-fastify/src"],
      "@teable/v2-contract-http-hono": ["../contract-http-hono/src"],
      "@teable/v2-contract-http-openapi": ["../contract-http-openapi/src"],
      "@teable/v2-contract-http-openapi/*": ["../contract-http-openapi/src/*"],
      "@teable/v2-contract-http-implementation": ["../contract-http-implementation/src"],
      "@teable/v2-contract-http-implementation/*": ["../contract-http-implementation/src/*"],
      "@teable/v2-contract-http": ["../contract-http/src"],
      "@teable/v2-contract-http/*": ["../contract-http/src/*"],
      "@teable/v2-adapter-logger-console": ["../adapter-logger-console/src"],
      "@teable/v2-adapter-csv-parser-papaparse": ["../adapter-csv-parser-papaparse/src"],
      "@teable/v2-adapter-table-repository-postgres": ["../adapter-table-repository-postgres/src"],
      "@teable/v2-adapter-repository-postgres": ["../adapter-repository-postgres/src"],
      "@teable/v2-adapter-record-repository-postgres": [
        "../adapter-record-repository-postgres/src"
      ],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-core/*": ["../core/src/*"],
      "@teable/v2-table-templates": ["../table-templates/src"],
      "@teable/v2-adapter-db-postgres-pg": ["../adapter-db-postgres-pg/src"],
      "@teable/v2-adapter-db-postgres-postgresjs": ["../adapter-db-postgres-postgresjs/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/v2-postgres-schema": ["../postgres-schema/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "../container-node-test/src/**/*.spec.ts",
    "../container-node-test/src/**/*.test.ts",
    "../contract-http-client/src/**/*.spec.ts",
    "../contract-http-client/src/**/*.test.ts",
    "../contract-http-express/src/**/*.spec.ts",
    "../contract-http-express/src/**/*.test.ts",
    "../contract-http-fastify/src/**/*.spec.ts",
    "../contract-http-fastify/src/**/*.test.ts",
    "../contract-http-hono/src/**/*.spec.ts",
    "../contract-http-hono/src/**/*.test.ts",
    "../contract-http-openapi/src/**/*.spec.ts",
    "../contract-http-openapi/src/**/*.test.ts",
    "../contract-http-implementation/src/**/*.spec.ts",
    "../contract-http-implementation/src/**/*.test.ts",
    "../contract-http/src/**/*.spec.ts",
    "../contract-http/src/**/*.test.ts",
    "../adapter-logger-console/src/**/*.spec.ts",
    "../adapter-logger-console/src/**/*.test.ts",
    "../adapter-csv-parser-papaparse/src/**/*.spec.ts",
    "../adapter-csv-parser-papaparse/src/**/*.test.ts",
    "../adapter-table-repository-postgres/src/**/*.spec.ts",
    "../adapter-table-repository-postgres/src/**/*.test.ts",
    "../adapter-repository-postgres/src/**/*.spec.ts",
    "../adapter-repository-postgres/src/**/*.test.ts",
    "../adapter-record-repository-postgres/src/**/*.spec.ts",
    "../adapter-record-repository-postgres/src/**/*.test.ts",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../table-templates/src/**/*.spec.ts",
    "../table-templates/src/**/*.test.ts",
    "../adapter-db-postgres-pg/src/**/*.spec.ts",
    "../adapter-db-postgres-pg/src/**/*.test.ts",
    "../adapter-db-postgres-postgresjs/src/**/*.spec.ts",
    "../adapter-db-postgres-postgresjs/src/**/*.test.ts",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../formula/src/**/*.spec.ts",
    "../../formula/src/**/*.test.ts"
  ],
  "include": ["src", "../../core/src"]
}

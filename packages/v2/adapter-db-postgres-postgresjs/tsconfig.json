{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-adapter-db-postgres-postgresjs",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/v2-adapter-db-postgres-shared": ["../adapter-db-postgres-shared/src"],
      "@teable/core": ["../../core/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-core/*": ["../core/src/*"],
      "@teable/v2-di": ["../di/src"]
    },
    "types": ["node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "../adapter-db-postgres-shared/src/**/*.spec.ts",
    "../adapter-db-postgres-shared/src/**/*.test.ts",
    "../adapter-db-postgres-shared/src/**/__tests__/**",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../core/src/**/__tests__/**",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../core/src/**/__tests__/**"
  ],
  "include": ["src"]
}

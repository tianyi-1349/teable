{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-container-node",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@teable/core": ["../../core/src"],
      "@teable/v2-adapter-table-repository-postgres": ["../adapter-table-repository-postgres/src"],
      "@teable/v2-adapter-repository-postgres": ["../adapter-repository-postgres/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-core/*": ["../core/src/*"],
      "@teable/v2-adapter-db-postgres-pg": ["../adapter-db-postgres-pg/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/v2-adapter-csv-parser-papaparse": ["../adapter-csv-parser-papaparse/src"],
      "@teable/v2-adapter-record-repository-postgres": [
        "../adapter-record-repository-postgres/src"
      ],
      "@teable/v2-contract-http": ["../contract-http/src"],
      "@teable/v2-contract-http/*": ["../contract-http/src/*"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "../core/src/**/*.spec.ts",
    "../core/src/**/*.test.ts",
    "../core/src/**/__tests__/**",
    "../../core/src/**/*.spec.ts",
    "../../core/src/**/*.test.ts",
    "../../core/src/**/__tests__/**",
    "../adapter-db-postgres-pg/src/**/*.spec.ts",
    "../adapter-db-postgres-pg/src/**/*.test.ts",
    "../adapter-db-postgres-pg/src/**/__tests__/**",
    "../adapter-record-repository-postgres/src/**/*.spec.ts",
    "../adapter-record-repository-postgres/src/**/*.test.ts",
    "../adapter-record-repository-postgres/src/**/__tests__/**",
    "../adapter-repository-postgres/src/**/*.spec.ts",
    "../adapter-repository-postgres/src/**/*.test.ts",
    "../adapter-repository-postgres/src/**/__tests__/**",
    "../adapter-table-repository-postgres/src/**/*.spec.ts",
    "../adapter-table-repository-postgres/src/**/*.test.ts",
    "../adapter-table-repository-postgres/src/**/__tests__/**",
    "../contract-http/src/**/*.spec.ts",
    "../contract-http/src/**/*.test.ts",
    "../contract-http/src/**/__tests__/**",
    "../table-templates/src/**/*.spec.ts",
    "../table-templates/src/**/*.test.ts",
    "../table-templates/src/**/__tests__/**"
  ],
  "include": [
    "src",
    "../adapter-table-repository-postgres/src",
    "../adapter-repository-postgres/src",
    "../core/src",
    "../../core/src",
    "../adapter-db-postgres-pg/src",
    "../di/src",
    "../adapter-record-repository-postgres/src",
    "../adapter-csv-parser-papaparse/src",
    "../contract-http/src",
    "../table-templates/src"
  ]
}
